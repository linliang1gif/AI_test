# Pydantic Models
class ProjectCreate(BaseModel):
    name: str
    description: str
    environment: str
    baseUrl: str

class TestRunConfig(BaseModel):
    project_id: Optional[int] = None
    test_type: str = "all"
    environment: str = "development"

class APITestRequest(BaseModel):
    endpoint: str
    method: str

class LoginRequest(BaseModel):
    username: str
    password: str
    parameters: Dict[str, Any] = {}

class BackendAPIServer:
    """Backend API Server for React Frontend"""
    
    def __init__(self, host: str = "127.0.0.1", port: int = 8000):
        self.host = host
        self.port = port
        
        # 初始化工具
        self.logger = get_logger("api_server")
        self.data_manager = get_data_manager()
        
        self.app = FastAPI(
            title="AI Test Platform API",
            description="Backend API for AI Test Engineer Platform",
            version="1.0.0"
        )
        
        self.logger.info(f"初始化API服务器 - {host}:{port}")
        
        # 设置CORS
        self.app.add_middleware(
            CORSMiddleware,
            allow_origins=[
                "http://localhost:3000", 
                "http://127.0.0.1:3000",
                "http://localhost:8081",
                "http://127.0.0.1:8081",
                "*"  # 开发环境允许所有来源
            ],
            allow_credentials=True,
            allow_methods=["*"],
            allow_headers=["*"],
        )
        
        # 数据持久化文件路径
        self.data_dir = Path("data")
        self.data_dir.mkdir(exist_ok=True)
        self.data_file = self.data_dir / "platform_data.json"
        
        # 加载持久化数据
        self._load_data()
        
        # 数据存储 (生产环境应使用数据库)
        if not hasattr(self, 'projects'):
            self.projects = []
        
        if not hasattr(self, 'apis'):
            self.apis = []
        
        if not hasattr(self, 'test_cases'):
            self.test_cases = []
        
        if not hasattr(self, 'test_runs'):
            self.test_runs = []
        
        # AI提供商配置
        if not hasattr(self, 'ai_providers'):
            self.ai_providers = [
            {
                "id": "ollama",
                "name": "Ollama",
                "description": "本地AI模型服务",
                "type": "local",
                "status": "available",
                "models": ["qwen2.5:1.5b", "qwen2.5-coder:latest"],
                "default_model": "qwen2.5:1.5b",
                "config": {
                    "base_url": "http://localhost:11434",
                    "timeout": 60
                }
            },
            {
                "id": "deepseek",
                "name": "DeepSeek",
                "description": "DeepSeek AI API服务",
                "type": "cloud",
                "status": "available",
                "models": ["deepseek-chat", "deepseek-coder"],
                "default_model": "deepseek-chat",
                "config": {
                    "base_url": "https://api.deepseek.com",
                    "api_key": "sk-***"
                }
            },
            {
                "id": "openai",
                "name": "OpenAI",
                "description": "OpenAI GPT API服务",
                "type": "cloud",
                "status": "unavailable",
                "models": ["gpt-3.5-turbo", "gpt-4"],
                "default_model": "gpt-3.5-turbo",
                "config": {
                    "base_url": "https://api.openai.com/v1",
                    "api_key": ""
                }
            }
        ]
        
        # 当前选择的AI提供商
        if not hasattr(self, 'current_ai_provider'):
            self.current_ai_provider = "ollama"
        
        if not hasattr(self, 'reports'):
            self.reports = []
        
        if not hasattr(self, 'scripts'):
            self.scripts = [
                {
                    "id": 1,
                    "name": "test_user_authentication.py",
                    "description": "用户认证功能自动化测试脚本",
                    "framework": "pytest",
                    "language": "Python",
                    "status": "ready",
                    "lastGenerated": "2024-01-15",
                    "testCount": 5
                },
                {
                    "id": 2,
                    "name": "test_api_endpoints.py",
                    "description": "API接口自动化测试脚本",
                    "framework": "pytest",
                    "language": "Python",
                    "status": "ready",
                    "lastGenerated": "2024-01-14",
                    "testCount": 8
                },
                {
                    "id": 3,
                    "name": "test_data_validation.py",
                    "description": "数据验证自动化测试脚本",
                    "framework": "pytest",
                    "language": "Python",
                    "status": "ready",
                    "lastGenerated": "2024-01-13",
                    "testCount": 6
                }
            ]
        
        self.running_tasks = {}
        
        # 设置路由
        self._setup_routes()
    
    def _load_data(self):
        """从JSON文件加载持久化数据"""
        try:
            if self.data_file.exists():
                with open(self.data_file, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    self.projects = data.get('projects', [])
                    self.apis = data.get('apis', [])
                    self.test_cases = data.get('test_cases', [])
                    self.test_runs = data.get('test_runs', [])
                    self.reports = data.get('reports', [])
                    self.scripts = data.get('scripts', [])
                    self.current_ai_provider = data.get('current_ai_provider', 'ollama')
                    print(f"✅ 成功加载 {len(self.test_cases)} 个测试用例")
        except Exception as e:
            print(f"⚠️ 数据加载失败: {e}, 使用默认数据")
    
    def _save_data(self):
        """保存数据到JSON文件"""
        try:
            data = {
                'projects': self.projects,
                'apis': self.apis,
                'test_cases': self.test_cases,
                'test_runs': self.test_runs,
                'reports': self.reports,
                'scripts': self.scripts,
                'current_ai_provider': self.current_ai_provider,
                'last_updated': datetime.now().isoformat()
            }
            with open(self.data_file, 'w', encoding='utf-8') as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            print(f"✅ 数据已保存: {len(self.test_cases)} 个测试用例")
        except Exception as e:
            print(f"❌ 数据保存失败: {e}")
    
    def _setup_routes(self):
        """设置API路由"""
        
        # Dashboard API
        @self.app.get("/api/dashboard/stats")
        async def get_dashboard_stats():
            """获取仪表板统计数据"""
            return {
                "totalTests": 156,
                "passed": 142,
                "failed": 14,
                "coverage": 85,
                "recentTests": [
                    {"id": 1, "name": "用户登录接口", "status": "passed", "time": "2分钟前"},
                    {"id": 2, "name": "支付网关", "status": "failed", "time": "5分钟前"}
                ]
            }
        
        # Projects API
        @self.app.get("/api/projects")
        async def get_projects():
            """获取项目列表"""
            return {"projects": self.projects}
        
        @self.app.post("/api/projects")
        async def create_project(project: ProjectCreate):
            """创建新项目"""
            new_project = {
                "id": len(self.projects) + 1,
                "name": project.name,
                "description": project.description,
                "environment": project.environment,
                "baseUrl": project.baseUrl,
                "testsCount": 0,
                "lastRun": "Never",
                "status": "active"
            }
            self.projects.append(new_project)
            return {"success": True, "project": new_project}
        
        @self.app.delete("/api/projects/{project_id}")
        async def delete_project(project_id: int):
            """删除项目"""
            self.projects = [p for p in self.projects if p["id"] != project_id]
            return {"success": True}
        
        # API Explorer
        @self.app.get("/api/apis")
        async def get_apis():
            """获取API列表"""
            return {"apis": self.apis}
        
        @self.app.post("/api/swagger/parse")
        async def parse_swagger(request: Request):
            """解析Swagger文档"""
            data = await request.json()
            swagger_url = data.get("url", "")
            
            # 模拟解析Swagger
            new_apis = [
                {
                    "id": len(self.apis) + 1,
                    "method": "GET",
                    "path": "/api/swagger-endpoint",
                    "description": "Endpoint from Swagger documentation",
                    "parameters": ["param1", "param2"],
                    "status": "pending"
                }
            ]
            self.apis.extend(new_apis)
            
            return {
                "success": True,
                "message": f"Successfully parsed {len(new_apis)} endpoints",
                "apis": new_apis
            }
        
        @self.app.post("/api/swagger/upload")
        async def upload_swagger(file: UploadFile = File(...)):
            """上传并解析Swagger文件"""
            try:
                # 读取文件内容
                content = await file.read()
                content_str = content.decode('utf-8')
                
                # 解析JSON或YAML
                import json
                
                try:
                    if file.filename.endswith(('.yaml', '.yml')):
                        try:
                            import yaml
                            swagger_data = yaml.safe_load(content_str)
                        except ImportError:
                            return {
                                "success": False,
                                "message": "YAML解析需要安装PyYAML库: pip install pyyaml"
                            }
                    else:
                        swagger_data = json.loads(content_str)
                except Exception as e:
                    return {
                        "success": False,
                        "message": f"文件解析失败: {str(e)}"
                    }
                
                # 提取API信息
                new_apis = []
                paths = swagger_data.get('paths', {})
                
                for path, methods in paths.items():
                    for method, details in methods.items():
                        if method.upper() in ['GET', 'POST', 'PUT', 'DELETE', 'PATCH']:
                            api_info = {
                                "id": len(self.apis) + len(new_apis) + 1,
                                "method": method.upper(),
                                "path": path,
                                "summary": details.get('summary', ''),
                                "description": details.get('description', ''),
                                "tags": details.get('tags', []),
                                "parameters": [p.get('name', '') for p in details.get('parameters', [])],
                                "status": "pending"
                            }
                            new_apis.append(api_info)
                
                self.apis.extend(new_apis)
                self._save_data()
                
                return {
                    "success": True,
                    "message": f"成功解析 {len(new_apis)} 个API接口",
                    "count": len(new_apis),
                    "apis": new_apis
                }
                
            except Exception as e:
                return {
                    "success": False,
                    "message": f"上传失败: {str(e)}"
                }
        
        @self.app.post("/api/apis/{api_id}/generate-testcases")
        async def generate_testcases_from_api(api_id: int, project_id: Optional[int] = None):
            """从API生成测试用例"""
            try:
                # 查找API
                api = next((a for a in self.apis if a["id"] == api_id), None)
                if not api:
                    raise HTTPException(status_code=404, detail="API not found")
                
                # 生成测试用例
                test_cases = []
                base_id = len(self.test_cases) + 1
                
                # 为每个HTTP方法生成对应的测试用例
                method = api["method"]
                path = api["path"]
                
                # 正常场景
                test_cases.append({
                    "id": base_id,
                    "title": f"{method} {path} - 正常请求",
                    "steps": [
                        f"发送{method}请求到{path}",
                        "传入正确的参数",
                        "验证响应状态码"
                    ],
                    "expected": "返回200状态码,响应数据正确",
                    "priority": "High",
                    "module": api.get("tags", ["API测试"])[0] if api.get("tags") else "API测试",
                    "status": "pending",
                    "lastRun": "从未运行",
                    "project_id": project_id,
                    "api_id": api_id,
                    "source": "api_generated"
                })
                
                # 异常场景 - 参数错误
                if api.get("parameters"):
                    test_cases.append({
                        "id": base_id + 1,
                        "title": f"{method} {path} - 参数错误",
                        "steps": [
                            f"发送{method}请求到{path}",
                            "传入错误或缺失的参数",
                            "验证错误处理"
                        ],
                        "expected": "返回400状态码,错误信息明确",
                        "priority": "Medium",
                        "module": api.get("tags", ["API测试"])[0] if api.get("tags") else "API测试",
                        "status": "pending",
                        "lastRun": "从未运行",
                        "project_id": project_id,
                        "api_id": api_id,
                        "source": "api_generated"
                    })
                
                # 权限测试
                test_cases.append({
                    "id": base_id + 2,
                    "title": f"{method} {path} - 未授权访问",
                    "steps": [
                        f"不带认证信息发送{method}请求到{path}",
                        "验证权限控制"
                    ],
                    "expected": "返回401或403状态码",
                    "priority": "High",
                    "module": api.get("tags", ["API测试"])[0] if api.get("tags") else "API测试",
                    "status": "pending",
                    "lastRun": "从未运行",
                    "project_id": project_id,
                    "api_id": api_id,
                    "source": "api_generated"
                })
                
                # 添加到测试用例列表
                self.test_cases.extend(test_cases)
                self._save_data()
                
                return {
                    "success": True,
                    "count": len(test_cases),
                    "message": f"成功生成 {len(test_cases)} 个测试用例",
                    "testCases": test_cases
                }
                
            except HTTPException:
                raise
            except Exception as e:
                return {
                    "success": False,
                    "error": str(e)
                }
        
        # Test Cases API
        @self.app.get("/api/test-cases")
        async def get_test_cases(project_id: Optional[int] = None):
            """获取测试用例,可按项目筛选"""
            if project_id is not None:
                # 筛选指定项目的测试用例
                filtered_cases = [tc for tc in self.test_cases if tc.get('project_id') == project_id]
                return {"testCases": filtered_cases, "project_id": project_id}
            return {"testCases": self.test_cases}
        
        @self.app.post("/api/test-cases")
        async def create_test_case(request: Request):
            """创建测试用例"""
            data = await request.json()
            new_case = {
                "id": len(self.test_cases) + 1,
                **data,
                "status": "pending",
                "lastRun": "Never"
            }
            self.test_cases.append(new_case)
            self._save_data()  # 保存数据
            return {"success": True, "testCase": new_case}
        
        @self.app.post("/api/testcases/generate")
        async def generate_test_cases(
            background_tasks: BackgroundTasks, 
            file: UploadFile = File(...),
            project_id: Optional[int] = None
        ):
            """从需求文档生成测试用例"""
            try:
                # 保存上传的文件
                upload_dir = Path("uploads")
                upload_dir.mkdir(exist_ok=True)
                
                file_path = upload_dir / file.filename
                content = await file.read()
                
                with open(file_path, "wb") as f:
                    f.write(content)
                
                # 解析文档内容
                document_content = self._parse_document(str(file_path))
                
                if not document_content:
                    return {
                        "success": False,
                        "error": "无法解析文档内容,请确保文件格式正确"
                    }
                
                # 使用AI生成测试用例(优先)或智能关键词匹配(fallback)
                generated_test_cases = self._generate_test_cases_with_ai(document_content)
                
                # 添加项目关联和来源信息
                for test_case in generated_test_cases:
                    test_case['project_id'] = project_id  # 关联项目
                    test_case['source'] = 'ai_generated'  # 标记来源
                    test_case['api_id'] = None  # API关联(暂无)
                
                # 添加到测试用例列表
                self.test_cases.extend(generated_test_cases)
                
                # 保存到持久化存储
                self._save_data()
                
                # 如果知识库可用,保存到知识库
                if _tc_kb and generated_test_cases:
                    try:
                        _tc_kb.batch_save(generated_test_cases, source='ai_generated')
                    except Exception as e:
                        print(f"⚠️ 用例入库失败: {e}")
                
                return {
                    "success": True,
                    "count": len(generated_test_cases),
                    "message": f"成功生成 {len(generated_test_cases)} 个测试用例",
                    "testCases": generated_test_cases,
                    "project_id": project_id
                }
                
            except Exception as e:
                return {
                    "success": False,
                    "error": str(e)
                }
        
        # Reports API
        @self.app.get("/api/reports")
        async def get_reports():
            """获取报告列表"""
            return {"reports": self.reports}
        
        @self.app.get("/api/reports/{report_id}")
        async def get_report(report_id: int):
            """获取报告详情"""
            report = next((r for r in self.reports if r["id"] == report_id), None)
            if not report:
                raise HTTPException(status_code=404, detail="Report not found")
            return report
        
        @self.app.post("/api/reports/generate")
        async def generate_report(request: Request):
            """生成测试报告"""
            try:
                data = await request.json()
                test_run_id = data.get("test_run_id")
                report_type = data.get("type", "comprehensive")
                
                # 查找测试运行
                test_run = next((r for r in self.test_runs if r["id"] == test_run_id), None)
                if not test_run:
                    raise HTTPException(status_code=404, detail="Test run not found")
                
                # 生成报告
                report_id = len(self.reports) + 1
                report = {
                    "id": report_id,
                    "name": f"{test_run['name']} - 测试报告",
                    "type": report_type.replace("_", " ").title() + " Report",
                    "test_run_id": test_run_id,
                    "test_run_name": test_run["name"],
                    "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
                    "format": "HTML",
                    "size": "245 KB",
                    "testRuns": 1,
                    "totalTests": test_run.get("totalTests", 0),
                    "passed": test_run.get("passed", 0),
                    "failed": test_run.get("failed", 0),
                    "passRate": round((test_run.get("passed", 0) / test_run.get("totalTests", 1)) * 100, 1) if test_run.get("totalTests", 0) > 0 else 0,
                    "duration": test_run.get("duration", "0s"),
                    "logs": test_run.get("logs", []),
                    "summary": {
                        "total": test_run.get("totalTests", 0),
                        "passed": test_run.get("passed", 0),
                        "failed": test_run.get("failed", 0),
                        "skipped": test_run.get("skipped", 0),
                        "passRate": round((test_run.get("passed", 0) / test_run.get("totalTests", 1)) * 100, 1) if test_run.get("totalTests", 0) > 0 else 0
                    }
                }
                
                self.reports.append(report)
                self._save_data()
                
                return {"success": True, "report": report}
            except Exception as e:
                self.logger.error(f"生成报告失败: {str(e)}")
                raise HTTPException(status_code=500, detail=f"生成报告失败: {str(e)}")
        
        @self.app.get("/api/reports/{report_id}/html")
        async def get_report_html(report_id: int):
            """获取HTML格式报告"""
            report = next((r for r in self.reports if r["id"] == report_id), None)
            if not report:
                raise HTTPException(status_code=404, detail="Report not found")
            
            # 生成HTML报告
            html_content = self._generate_html_report(report)
            return HTMLResponse(content=html_content)
        
        @self.app.delete("/api/reports/{report_id}")
        async def delete_report(report_id: int):
            """删除报告"""
            report = next((r for r in self.reports if r["id"] == report_id), None)
            if not report:
                raise HTTPException(status_code=404, detail="Report not found")
            
            self.reports = [r for r in self.reports if r["id"] != report_id]
            self._save_data()
            
            return {"success": True, "message": "报告已删除"}
        
        # AI Insights API
        @self.app.get("/api/ai/agents")
        async def get_ai_agents():
            """获取AI代理状态"""
            agents = [
                {
                    "id": "requirement",
                    "name": "Requirement Agent",
                    "status": "ready",
                    "description": "Analyzes requirements and extracts testable scenarios"
                },
                {
                    "id": "testcase",
                    "name": "TestCase Agent", 
                    "status": "ready",
                    "description": "Generates comprehensive test cases from requirements"
                }
            ]
            return {"agents": agents}
        @self.app.get("/api/ai/current")
        async def get_current_ai_config():
            """获取当前AI配置"""
            current_provider = None
            for provider in self.ai_providers:
                if provider["id"] == self.current_ai_provider:
                    current_provider = provider
                    break
            
            if current_provider:
                return {
                    "current_provider": current_provider["id"],
                    "current_model": current_provider["default_model"],
                    "provider_name": current_provider["name"],
                    "provider_type": current_provider["type"],
                    "status": current_provider["status"]
                }
            else:
                return {
                    "current_provider": "ollama",
                    "current_model": "qwen2.5:1.5b",
                    "provider_name": "Ollama",
                    "provider_type": "local",
                    "status": "available"
                }
        

        
        @self.app.get("/api/ai/providers/list")
        async def get_ai_providers_list():
            """获取AI提供商列表"""
            return {
                "providers": self.ai_providers,
                "current": self.current_ai_provider
            }
        
        @self.app.post("/api/ai/providers/select")
        async def select_ai_provider(request: Request):
            """选择AI提供商"""
            data = await request.json()
            provider_id = data.get("provider_id")
            
            if not provider_id:
                raise HTTPException(status_code=400, detail="Provider ID is required")
            
            # 检查提供商是否存在
            provider = next((p for p in self.ai_providers if p["id"] == provider_id), None)
            if not provider:
                raise HTTPException(status_code=404, detail="Provider not found")
            
            # 更新当前提供商
            self.current_ai_provider = provider_id
            
            return {
                "success": True,
                "message": f"已切换到 {provider['name']} 提供商",
                "provider": provider
            }
        
        @self.app.get("/api/ai/providers/{provider_id}/status")
        async def check_provider_status(provider_id: str):
            """检查提供商状态"""
            provider = next((p for p in self.ai_providers if p["id"] == provider_id), None)
            if not provider:
                raise HTTPException(status_code=404, detail="Provider not found")
            
            # 检查Ollama服务状态
            if provider_id == "ollama":
                try:
                    import requests
                    response = requests.get("http://localhost:11434/api/tags", timeout=5)
                    if response.status_code == 200:
                        models_data = response.json()
                        models = [model["name"] for model in models_data.get("models", [])]
                        provider["models"] = models
                        provider["status"] = "available"
                    else:
                        provider["status"] = "unavailable"
                except Exception:
                    provider["status"] = "unavailable"
            
            return {"provider": provider}
        
        @self.app.get("/api/ai/providers")
        async def get_ai_providers():
            """获取AI提供商状态"""
            try:
                provider_manager = get_provider_manager()
                stats = provider_manager.get_provider_stats()
                
                providers = []
                for name, stat in stats.items():
                    providers.append({
                        "name": name,
                        "status": stat["status"],
                        "success_rate": stat["success_rate"],
                        "avg_response_time": stat["avg_response_time"],
                        "cost_per_token": stat["cost_per_token"],
                        "success_count": stat["success_count"],
                        "error_count": stat["error_count"]
                    })
                
                return {"providers": providers}
            except Exception as e:
                return {"providers": [], "error": str(e)}
        
        @self.app.get("/api/ai/providers/{provider_name}/models")
        async def get_provider_models(provider_name: str):
            """获取指定提供商的可用模型"""
            try:
                config = get_config()
                models = config.get_available_models(provider_name)
                return {"models": models}
            except Exception as e:
                raise HTTPException(status_code=404, detail=f"Provider not found: {str(e)}")
        
        @self.app.get("/api/ai/ollama/status")
        async def get_ollama_status():
            """检查Ollama服务状态"""
            try:
                import requests
                # 检查Ollama服务
                response = requests.get("http://localhost:11434/api/tags", timeout=5)
                if response.status_code == 200:
                    data = response.json()
                    models = data.get("models", [])
                    return {
                        "available": True,
                        "status": "running",
                        "url": "http://localhost:11434",
                        "models": [m.get("name") for m in models],
                        "model": "qwen2.5:1.5b",
                        "model_count": len(models)
                    }
                else:
                    return {
                        "available": False,
                        "status": "error",
                        "error": f"HTTP {response.status_code}"
                    }
            except Exception as e:
                return {
                    "available": False,
                    "status": "offline",
                    "error": str(e)
                }
        
        @self.app.post("/api/ai/providers/{provider_name}/test")
        async def test_ai_provider(provider_name: str):
            """测试AI提供商连接"""
            try:
                client = get_enhanced_ai_client(provider_name)
                
                # 发送测试请求
                start_time = time.time()
                response = client.generate_text("Hello, this is a test.", max_tokens=10)
                response_time = time.time() - start_time
                
                return {
                    "success": True,
                    "provider": provider_name,
                    "response_time": round(response_time, 3),
                    "response": response[:50] + "..." if len(response) > 50 else response
                }
            except Exception as e:
                return {
                    "success": False,
                    "provider": provider_name,
                    "error": str(e)
                }
        
        @self.app.post("/api/ai/providers/switch")
        async def switch_ai_provider(request: Request):
            """切换AI提供商"""
            try:
                data = await request.json()
                provider_name = data.get("provider")
                model_name = data.get("model")
                
                if not provider_name:
                    raise HTTPException(status_code=400, detail="Provider name is required")
                
                # 更新配置
                config = get_config()
                config.ai.default_provider = provider_name
                
                if model_name:
                    config.ai.default_model = model_name
                
                return {
                    "success": True,
                    "message": f"已切换到 {provider_name} 提供商",
                    "provider": provider_name,
                    "model": model_name or config.ai.default_model
                }
            except Exception as e:
                raise HTTPException(status_code=500, detail=str(e))
        
        @self.app.post("/api/ai/generate")
        async def generate_with_ai(background_tasks: BackgroundTasks, request: Request):
            """AI生成测试或自动化脚本"""
            data = await request.json()
            gen_type = data.get("type", "test_cases")  # test_cases 或 automation_script
            task_id = f"ai_{int(time.time())}"
            
            # 根据类型选择不同的生成任务
            if gen_type == "automation_script":
                # 生成自动化脚本
                background_tasks.add_task(self._generate_automation_script, task_id, data)
                
                self.running_tasks[task_id] = {
                    "status": "running",
                    "progress": 0,
                    "current_step": "初始化脚本生成",
                    "steps": ["分析测试用例", "生成脚本代码", "保存脚本文件"]
                }
                
                return {
                    "success": True,
                    "taskId": task_id,
                    "message": "自动化脚本生成任务已启动"
                }
            else:
                # 生成测试用例
                background_tasks.add_task(self._simulate_ai_generation, task_id, data)
                
                self.running_tasks[task_id] = {
                    "status": "running",
                    "progress": 0,
                    "current_step": "初始化",
                    "steps": ["需求解析", "测试点生成", "测试用例生成", "脚本生成"]
                }
                
                return {
                    "success": True,
                    "taskId": task_id,
                    "message": "AI生成任务已启动"
                }
        
        @self.app.get("/api/tasks/{task_id}/status")
        async def get_task_status(task_id: str):
            """获取任务状态"""
            if task_id not in self.running_tasks:
                raise HTTPException(status_code=404, detail="Task not found")
            return self.running_tasks[task_id]
        
