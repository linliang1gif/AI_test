        # ── 认证 API ────────────────────────────────────────────
        
        @self.app.post("/api/auth/login")
        async def login(request: Request, login_req: LoginRequest):
            """用户登录"""
            try:
                if not auth_manager:
                    # 简化版认证（开发环境）
                    return {
                        "success": True,
                        "token": "dev-token-123",
                        "user": {"username": login_req.username, "role": "user"}
                    }
                
                # 验证用户凭据
                user = auth_manager.authenticate_user(login_req.username, login_req.password)
                if not user:
                    raise HTTPException(status_code=401, detail="用户名或密码错误")
                
                # 生成访问令牌
                token = auth_manager.create_access_token(user["username"], user["role"])
                
                self.logger.info(f"用户登录成功: {user['username']}")
                
                return {
                    "success": True,
                    "token": token,
                    "user": {
                        "username": user["username"],
                        "role": user["role"]
                    }
                }
                
            except HTTPException:
                raise
            except Exception as e:
                self.logger.error(f"登录失败", e)
                raise HTTPException(status_code=500, detail="登录服务异常")
        
        @self.app.get("/api/auth/me")
        async def get_current_user_info(current_user: dict = Depends(get_current_user)):
