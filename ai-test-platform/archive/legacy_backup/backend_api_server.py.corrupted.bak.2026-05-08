        @self.app.get("/api/knowledge/stats")
        async def get_knowledge_stats():
            """获取所有知识库统计"""
            stats = {"available": KNOWLEDGE_AVAILABLE}
            try:
                if _bug_kb:
                    stats["bugs"] = _bug_kb.get_stats()
                if _healing_kb:
                    stats["healing"] = _healing_kb.get_stats()
                if _tc_kb:
                    stats["testcases"] = _tc_kb.get_stats()
                if _biz_kb:
                    stats["business"] = _biz_kb.get_stats()
            except Exception as e:
                stats["error"] = str(e)
            return stats

        @self.app.post("/api/knowledge/testcases/search")
        async def search_testcases_kb(request: Request):
            """知识库用例语义搜索"""
            if not _tc_kb:
                return {"results": [], "error": "知识库不可用"}
            try:
                data = await request.json()
                query = data.get("query", "")
                module = data.get("module", None)
                results = _tc_kb.search_similar_cases(query, module=module, top_k=10)
                return {"results": results}
            except Exception as e:
                return {"results": [], "error": str(e)}

        @self.app.get("/api/knowledge/coverage")
        async def get_knowledge_coverage():
            """需求-接口覆盖率报告"""
            if not _biz_kb:
                return {"error": "知识库不可用", "coverage_rate": 0}
            try:
                return _biz_kb.get_coverage_report()
            except Exception as e:
                return {"error": str(e), "coverage_rate": 0}
        
        # ── Test Runs API ────────────────────────────────────────────
        
        @self.app.get("/api/test-runs")
        async def get_test_runs():
            """获取所有测试运行记录"""
            return {"testRuns": self.test_runs}
        
        @self.app.post("/api/test-runs")
        async def start_test_run(background_tasks: BackgroundTasks, request: Request):
            """启动新的测试运行"""
            try:
                data = await request.json()
                environment = data.get("environment", "staging")
                project_id = data.get("project_id")
                test_case_ids = data.get("test_case_ids", [])
                
                # 创建新的测试运行记录
                run_id = len(self.test_runs) + 1
                
                # 如果指定了测试用例ID,使用指定的用例;否则使用所有用例
                if test_case_ids:
                    test_cases_to_run = [tc for tc in self.test_cases if tc["id"] in test_case_ids]
                elif project_id:
                    test_cases_to_run = [tc for tc in self.test_cases if tc.get("project_id") == project_id]
                else:
                    test_cases_to_run = self.test_cases
                
                total_tests = len(test_cases_to_run)
                
                new_run = {
                    "id": run_id,
                    "name": f"测试运行 #{run_id}",
                    "status": "running",
                    "environment": environment,
                    "progress": 0,
                    "totalTests": total_tests,
                    "passed": 0,
                    "failed": 0,
                    "pending": total_tests,
                    "duration": "0s",
                    "startTime": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    "endTime": None,
                    "project_id": project_id,
                    "test_case_ids": test_case_ids,
                    "logs": []
                }
                
                self.test_runs.append(new_run)
                self._save_data()
                
                # 在后台执行测试
                task_id = f"testrun_{run_id}_{int(time.time())}"
                background_tasks.add_task(self._execute_test_run, task_id, run_id, test_cases_to_run)
                
                return {
                    "success": True,
                    "testRun": new_run,
                    "taskId": task_id
                }
                
            except Exception as e:
                raise HTTPException(status_code=500, detail=f"启动测试运行失败: {str(e)}")
        
        @self.app.get("/api/test-runs/{run_id}/status")
        async def get_test_run_status(run_id: int):
            """获取测试运行状态"""
            run = next((r for r in self.test_runs if r["id"] == run_id), None)
            if not run:
                raise HTTPException(status_code=404, detail="测试运行不存在")
            
            return {"testRun": run}
        
        @self.app.post("/api/test-runs/{run_id}/pause")
        async def pause_test_run(run_id: int):
            """暂停测试运行"""
            run = next((r for r in self.test_runs if r["id"] == run_id), None)
            if not run:
                raise HTTPException(status_code=404, detail="测试运行不存在")
            
            if run["status"] == "running":
                run["status"] = "paused"
                self._save_data()
                return {"success": True, "message": "测试运行已暂停"}
            else:
                return {"success": False, "message": f"无法暂停状态为 {run['status']} 的测试运行"}
        
        @self.app.post("/api/test-runs/{run_id}/stop")
        async def stop_test_run(run_id: int):
            """停止测试运行"""
            run = next((r for r in self.test_runs if r["id"] == run_id), None)
            if not run:
                raise HTTPException(status_code=404, detail="测试运行不存在")
            
            if run["status"] in ["running", "paused"]:
                run["status"] = "stopped"
                run["endTime"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                self._save_data()
                return {"success": True, "message": "测试运行已停止"}
            else:
                return {"success": False, "message": f"无法停止状态为 {run['status']} 的测试运行"}
        
        @self.app.post("/api/test-runs/{run_id}/resume")
        async def resume_test_run(run_id: int, background_tasks: BackgroundTasks):
            """恢复测试运行"""
            run = next((r for r in self.test_runs if r["id"] == run_id), None)
            if not run:
                raise HTTPException(status_code=404, detail="测试运行不存在")
            
            if run["status"] == "paused":
                run["status"] = "running"
                self._save_data()
                
                # 继续执行剩余测试
                test_case_ids = run.get("test_case_ids", [])
                test_cases_to_run = [tc for tc in self.test_cases if tc["id"] in test_case_ids] if test_case_ids else self.test_cases
                
                task_id = f"testrun_{run_id}_resume_{int(time.time())}"
                background_tasks.add_task(self._execute_test_run, task_id, run_id, test_cases_to_run, resume=True)
                
                return {"success": True, "message": "测试运行已恢复"}
            else:
                return {"success": False, "message": f"无法恢复状态为 {run['status']} 的测试运行"}

    async def _execute_test_run(self, task_id: str, run_id: int, test_cases: List[Dict[str, Any]], resume: bool = False):
        """执行测试运行"""
        try:
            run = next((r for r in self.test_runs if r["id"] == run_id), None)
            if not run:
                return
            
            start_time = time.time()
            total_tests = len(test_cases)
            passed = run["passed"] if resume else 0
            failed = run["failed"] if resume else 0
            start_index = passed + failed if resume else 0
            
            # 添加初始日志
            run["logs"].append({
                "time": datetime.now().strftime("%H:%M:%S"),
                "level": "INFO",
                "message": f"开始执行测试运行,共 {total_tests} 个测试用例"
            })
            
            # 执行每个测试用例
            for i in range(start_index, total_tests):
                # 检查是否被暂停或停止
                current_run = next((r for r in self.test_runs if r["id"] == run_id), None)
                if current_run and current_run["status"] in ["paused", "stopped"]:
                    break
                
                test_case = test_cases[i]
                
                # 添加日志
                run["logs"].append({
                    "time": datetime.now().strftime("%H:%M:%S"),
                    "level": "INFO",
                    "message": f"执行测试用例: {test_case['title']}"
                })
                
                # 模拟测试执行
                await asyncio.sleep(2)  # 模拟测试执行时间
                
                # 随机决定测试结果(80%通过率)
                import random
                test_passed = random.random() < 0.8
                
                if test_passed:
                    passed += 1
                    run["logs"].append({
                        "time": datetime.now().strftime("%H:%M:%S"),
                        "level": "PASS",
                        "message": f"✓ {test_case['title']} - 通过"
                    })
                else:
                    failed += 1
                    run["logs"].append({
                        "time": datetime.now().strftime("%H:%M:%S"),
                        "level": "FAIL",
                        "message": f"✗ {test_case['title']} - 失败"
                    })
                
                # 更新进度
                progress = int((i + 1) / total_tests * 100)
                pending = total_tests - (i + 1)
                elapsed_time = int(time.time() - start_time)
                
                run.update({
                    "progress": progress,
                    "passed": passed,
                    "failed": failed,
                    "pending": pending,
                    "duration": f"{elapsed_time // 60}m {elapsed_time % 60}s"
                })
                
                # 保存进度
                self._save_data()
            
            # 完成测试运行
            current_run = next((r for r in self.test_runs if r["id"] == run_id), None)
            if current_run and current_run["status"] == "running":
                run["status"] = "completed" if failed == 0 else "failed"
                run["endTime"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                run["logs"].append({
                    "time": datetime.now().strftime("%H:%M:%S"),
                    "level": "INFO",
                    "message": f"测试运行完成: {passed}/{total_tests} 通过, {failed}/{total_tests} 失败"
                })
                self._save_data()
            
        except Exception as e:
            run["status"] = "failed"
            run["logs"].append({
                "time": datetime.now().strftime("%H:%M:%S"),
                "level": "FAIL",
                "message": f"测试运行异常: {str(e)}"
            })
            self._save_data()
    
    async def _generate_automation_script(self, task_id: str, config: Dict[str, Any]):
        """生成自动化脚本"""
        try:
            framework = config.get("framework", "pytest")
            language = config.get("language", "Python")
            test_type = config.get("test_type", "API Tests")
            
            # 步骤1: 分析测试用例
            await asyncio.sleep(1)
            self.running_tasks[task_id].update({
                "progress": 33,
                "current_step": "分析测试用例",
                "status": "running"
            })
            
            # 获取相关测试用例
            relevant_testcases = [tc for tc in self.test_cases if test_type.lower() in tc.get("module", "").lower()]
            if not relevant_testcases:
                relevant_testcases = self.test_cases[:5]  # 默认取前5个
            
            # 步骤2: 生成脚本代码
            await asyncio.sleep(2)
            self.running_tasks[task_id].update({
                "progress": 66,
                "current_step": "生成脚本代码",
                "status": "running"
            })
            
            # 生成脚本
            script_name = f"test_{test_type.lower().replace(' ', '_')}_{int(time.time())}.py"
            script_description = f"基于{len(relevant_testcases)}个测试用例生成的{framework}自动化脚本"
            
            new_script = {
                "id": len(self.scripts) + 1,
                "name": script_name,
                "description": script_description,
                "framework": framework,
                "language": language,
                "status": "ready",
                "lastGenerated": "刚刚",
                "testCount": len(relevant_testcases)
            }
            
            # 步骤3: 保存脚本文件
            await asyncio.sleep(1)
            self.running_tasks[task_id].update({
                "progress": 100,
                "current_step": "保存脚本文件",
                "status": "completed"
            })
            
            # 添加到脚本列表
            self.scripts.append(new_script)
            self._save_data()
            
            # 更新任务结果
            self.running_tasks[task_id].update({
                "status": "completed",
                "result": {
                    "script_id": new_script["id"],
                    "script_name": script_name,
                    "testcases_used": len(relevant_testcases),
                    "framework": framework,
                    "language": language
                }
            })
            
        except Exception as e:
            self.running_tasks[task_id].update({
                "status": "failed",
                "error": str(e)
            })
    
