            return {"scripts": self.scripts}
        
        @self.app.post("/api/automation/scripts/generate")
        async def generate_automation_script_from_testcases(background_tasks: BackgroundTasks, request: Request):
            """从测试用例生成自动化脚本"""
            try:
                data = await request.json()
                testcase_ids = data.get("testcase_ids", [])
                framework = data.get("framework", "pytest")
                language = data.get("language", "Python")
                
                if not testcase_ids:
                    # 如果没有指定测试用例,使用所有测试用例
                    testcase_ids = [tc["id"] for tc in self.test_cases]
                
                # 获取测试用例
                selected_testcases = [tc for tc in self.test_cases if tc["id"] in testcase_ids]
                
                if not selected_testcases:
                    return {
                        "success": False,
                        "error": "没有找到指定的测试用例"
                    }
                
                # 生成脚本
                task_id = f"script_gen_{int(time.time())}"
                background_tasks.add_task(
                    self._generate_script_from_testcases, 
                    task_id, 
                    selected_testcases, 
                    framework, 
                    language
                )
                
                return {
                    "success": True,
                    "taskId": task_id,
                    "message": f"开始从 {len(selected_testcases)} 个测试用例生成自动化脚本"
                }
                
            except Exception as e:
                return {
                    "success": False,
                    "error": str(e)
                }
        
        # File Upload API
        @self.app.post("/api/upload/requirement")
        async def upload_requirement(file: UploadFile = File(...)):
            """上传需求文档"""
            try:
                upload_dir = Path("uploads")
                upload_dir.mkdir(exist_ok=True)
                
                file_path = upload_dir / file.filename
                content = await file.read()
                
                with open(file_path, "wb") as f:
                    f.write(content)
                
                return {
                    "success": True,
                    "message": f"需求文档 {file.filename} 上传成功",
                    "filePath": str(file_path),
                    "fileSize": len(content)
                }
                
            except Exception as e:
                raise HTTPException(status_code=500, detail=f"文件上传失败: {str(e)}")
        
        @self.app.post("/api/upload/swagger")
        async def upload_swagger(file: UploadFile = File(...)):
            """上传Swagger文档"""
            try:
                upload_dir = Path("uploads")
                upload_dir.mkdir(exist_ok=True)
                
                file_path = upload_dir / file.filename
                content = await file.read()
                
                with open(file_path, "wb") as f:
                    f.write(content)
                
                return {
                    "success": True,
                    "message": f"Swagger文档 {file.filename} 上传成功",
                    "filePath": str(file_path),
                    "fileSize": len(content)
                }
                
            except Exception as e:
                raise HTTPException(status_code=500, detail=f"文件上传失败: {str(e)}")
        
        # 测试用例下载API
        @self.app.get("/api/test-cases/export")
        async def export_test_cases():
            """导出测试用例为Excel文件"""
            try:
                import pandas as pd
                from io import BytesIO
                
                # 准备测试用例数据
                export_data = []
                for case in self.test_cases:
                    export_data.append({
                        "ID": case["id"],
                        "标题": case["title"],
                        "测试步骤": " | ".join(case["steps"]),
                        "预期结果": case["expected"],
                        "优先级": case["priority"],
                        "模块": case["module"],
                        "状态": case["status"],
                        "最后执行": case["lastRun"]
                    })
                
                # 创建Excel文件
                df = pd.DataFrame(export_data)
                
                # 保存到文件
                output_dir = Path("output")
                output_dir.mkdir(exist_ok=True)
                
                file_path = output_dir / f"测试用例_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx"
                df.to_excel(file_path, index=False, engine='openpyxl')
                
                return FileResponse(
                    path=file_path,
                    filename=file_path.name,
                    media_type='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                )
                
            except Exception as e:
                raise HTTPException(status_code=500, detail=f"导出失败: {str(e)}")
        
        # 自动化脚本下载API
        @self.app.get("/api/automation/scripts/{script_id}/download")
        async def download_script(script_id: int):
            """下载自动化脚本文件"""
            try:
                script = next((s for s in self.scripts if s["id"] == script_id), None)
                if not script:
                    raise HTTPException(status_code=404, detail="脚本不存在")
                
                # 生成真实的pytest脚本内容
                script_content = self._generate_pytest_script(script)
                
                # 保存到文件
                output_dir = Path("output/scripts")
                output_dir.mkdir(parents=True, exist_ok=True)
                
                file_path = output_dir / script["name"]
                with open(file_path, "w", encoding="utf-8") as f:
                    f.write(script_content)
                
                return FileResponse(
                    path=file_path,
                    filename=script["name"],
                    media_type='text/plain'
                )
                
            except Exception as e:
                raise HTTPException(status_code=500, detail=f"下载失败: {str(e)}")
        
