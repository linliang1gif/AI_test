# AI Test Platform - 环境配置示例
# 复制此文件为 .env 并填写实际配置

# ========== 运行模式配置 ==========

# 应用运行模式 (mock/real)
# mock: 使用httpbin等公开API进行本地测试
# real: 连接真实被测系统
APP_MODE=mock

# 是否使用Mock数据
USE_MOCK_DATA=true

# Mock模式下的目标API地址
MOCK_API_BASE_URL=https://httpbin.org

# 真实模式下的目标API地址 (请勿提交真实地址)
TARGET_API_BASE_URL=

# 真实模式下的API Token (请勿提交真实Token)
TARGET_API_TOKEN=

# ========== AI 配置 ==========

# AI提供商 (none/deepseek/openai/ollama)
# none: 不使用AI，仅规则分析
AI_PROVIDER=none

# AI分析模式 (rule/ai/hybrid)
# rule: 仅使用规则分析
# ai: 使用AI大模型分析
# hybrid: 规则+AI混合分析
AI_ANALYSIS_MODE=rule

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API配置 (可选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama本地模型配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=qwen2.5:1.5b,deepseek-coder,llama3

# 默认AI提供商 (deepseek/openai/ollama)
DEFAULT_AI_PROVIDER=ollama
DEFAULT_AI_MODEL=qwen2.5:1.5b

# AI参数配置
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4000
AI_TIMEOUT=60

# ========== 测试配置 ==========

# 测试环境基础URL
BASE_TEST_URL=http://localhost:8080

# 请求超时时间(秒)
REQUEST_TIMEOUT=30

# AI分析超时时间(秒)
AI_ANALYSIS_TIMEOUT=60

# 最大重试次数
MAX_RETRIES=3

# 并行测试工作线程数
PARALLEL_WORKERS=4

# 测试数据规模 (small/medium/large)
TEST_DATA_SIZE=medium

# ========== 数据库配置 ==========

# SQLite数据库路径
SQLITE_DB_PATH=data/test_platform.db

# ChromaDB配置 (可选)
CHROMA_DB_PATH=knowledge/chroma_db
CHROMA_COLLECTION_NAME=test_knowledge

# ========== 服务器配置 ==========

# 后端API服务器
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# 前端开发服务器
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# ========== 日志配置 ==========

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/platform.log

# ========== 安全配置 ==========

# JWT密钥 (生产环境请使用强密钥)
JWT_SECRET_KEY=your_secret_key_change_in_production

# 鉴权配置加密密钥；使用 Python 生成：from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
AUTH_CONFIG_KEY=

# JWT过期时间(小时)
JWT_EXPIRATION_HOURS=24

# 是否启用认证 (true/false)
ENABLE_AUTH=false

# ========== 其他配置 ==========

# 上传文件大小限制(MB)
MAX_UPLOAD_SIZE=50

# 报告保留天数
REPORT_RETENTION_DAYS=30

# 是否启用调试模式
DEBUG_MODE=false
